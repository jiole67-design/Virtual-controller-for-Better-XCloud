.rb-setting input[type=text], .rb-setting select, .rb-setting textarea{ width:100%; box-sizing:border-box; padding:8px; border-radius:7px; border:1px solid rgba(255,255,255,.20); background:rgba(255,255,255,.08); color:white; pointer-events:auto; touch-action:auto; }
.rb-ui-button{ padding:10px; border:0; border-radius:8px; color:white; background:rgba(255,255,255,.13); pointer-events:auto; touch-action:manipulation; cursor:pointer; }
.rb-ui-button:active{ background:rgba(255,255,255,.28); }
.rb-actions{ display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:15px; }
.rb-status{ margin-top:10px; padding:10px; border-radius:8px; text-align:center; font-size:12px; background:rgba(255,180,0,.13); word-break:break-all; }
.rb-section{ margin-top:18px; border-top:1px solid rgba(255,255,255,.12); padding-top:12px; }
.rb-combo-item{ padding:12px 0; border-bottom:1px solid rgba(255,255,255,.08); }
.rb-combo-delete{ width:100%; margin-top:8px; padding:8px; border:0; border-radius:7px; color:white; background:rgba(255,50,50,.22); cursor:pointer; }
#rb-game-profile{ width:100%; box-sizing:border-box; padding:10px; border-radius:8px; border:1px solid rgba(255,255,255,.20); background:rgba(255,255,255,.08); color:white; font-size:15px; }
.rb-profile-item{ display:flex; align-items:center; justify-content:space-between; gap:8px; padding:9px 0; border-bottom:1px solid rgba(255,255,255,.08); }
.rb-profile-name{ flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.rb-profile-load{ padding:7px 12px; border:0; border-radius:7px; color:white; background:rgba(0,140,80,.65); cursor:pointer; }
.rb-profile-delete{ padding:7px 12px; border:0; border-radius:7px; color:white; background:rgba(255,50,50,.25); cursor:pointer; }
@media(orientation:portrait){ #rb-root{ display:none; } }
`;
    document.documentElement.appendChild(css);
}
addCSS();

function createButton(id){
    const def = BUTTONS[id];
    const el = document.createElement('div');
    el.id = `rb-${id}`;
    el.className = 'rb-button';
    el.dataset.id = id;

    const miniBadge = document.createElement('div');
    miniBadge.className = 'rb-mini-label';
    miniBadge.textContent = def.name;
    el.appendChild(miniBadge);

    const label = document.createElement('div');
    label.className = 'rb-label';
    label.textContent = settings.names[id] || def.name;
    el.appendChild(label);

    applyLayout(el, id);
    updateButtonLabel(id);
    return el;
}

function applyLayout(el, id){
    const l = settings.layout[id];
    if(!l) return;
    el.style.left = `${l.x}%`;
    el.style.top = `${l.y}%`;
    el.style.width = `${l.size}px`;
    el.style.height = `${l.size}px`;
    el.style.opacity = l.opacity;
}

function updateButtonLabel(id){
    const el = document.getElementById(`rb-${id}`);
    if(!el) return;
    const label = el.querySelector('.rb-label');
    let iconUrl = settings.icons && settings.icons[id] ? settings.icons[id].replace(/[\r\n\s]/g, '') : '';

    if(iconUrl){
        if(!iconUrl.startsWith('http') && !iconUrl.startsWith('data:image')){
            iconUrl = 'data:image/png;base64,' + iconUrl;
        }
        el.style.setProperty('background-image', `url("${iconUrl}")`, 'important');
        if(label) label.style.display = 'none';
    } else {
        el.style.backgroundImage = 'none';
        if(label){
            label.style.display = 'block';
            label.textContent = settings.names[id] || BUTTONS[id].name;
        }
    }
}

function createCombo(combo){
    const el = document.createElement('div');
    el.className = 'rb-combo';
    el.dataset.comboId = combo.id;
    el.style.left = `${combo.x}%`;
    el.style.top = `${combo.y}%`;
    el.style.width = `${combo.size}px`;
    el.style.height = `${combo.size}px`;
    el.style.opacity = combo.opacity;

    const label = document.createElement('div');
    label.className = 'rb-label';
    label.textContent = combo.name;
    el.appendChild(label);
    return el;
}

function canDrag(){ return (settings.dragEnabled === true); }

function startDrag(el, e){
    if(!canDrag()) return false;
    if (e.cancelable) e.preventDefault(); 
    e.stopPropagation();
    state.dragging = true;
    state.dragTarget = el;
    state.dragPointer = e.pointerId || 0;

    const rect = el.getBoundingClientRect();
    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
    const clientY = e.touches ? e.touches[0].clientY : e.clientY;

    state.dragOffsetX = clientX - (rect.left + rect.width / 2);
    state.dragOffsetY = clientY - (rect.top + rect.height / 2);

    el.classList.add('rb-dragging');
    try{ if (el.setPointerCapture) el.setPointerCapture(e.pointerId); } catch(_){}
    return true;
}

function moveDrag(e){
    if(!state.dragging || !state.dragTarget) return;
    if (e.cancelable) e.preventDefault(); 
    e.stopPropagation();

    const el = state.dragTarget;
    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
    const clientY = e.touches ? e.touches[0].clientY : e.clientY;

    let x = (clientX - state.dragOffsetX) / window.innerWidth * 100;
    let y = (clientY - state.dragOffsetY) / window.innerHeight * 100;
    x = Math.max(2, Math.min(98, x));
    y = Math.max(3, Math.min(97, y));

    if(el.dataset.id){
        const id = el.dataset.id;
        if(settings.layout[id]){
            settings.layout[id].x = x; settings.layout[id].y = y;
            el.style.left = `${x}%`; el.style.top = `${y}%`;
        }
    } else if(el.dataset.comboId){
        const combo = settings.combos.find(c => c.id === el.dataset.comboId);
        if(combo){
            combo.x = x; combo.y = y;
            el.style.left = `${x}%`; el.style.top = `${y}%`;
        }
    }
}

function endDrag(e){
    if(!state.dragging) return;
    const el = state.dragTarget;
    if(el){
        el.classList.remove('rb-dragging');
        try{ if (el.releasePointerCapture && e.pointerId) el.releasePointerCapture(e.pointerId); } catch(_){}
    }
    state.dragging = false;
    state.dragTarget = null;
    state.dragPointer = null;
    saveSettings();
}

/* 长按弹窗滑动调节属性 Modal */
function openAdjustModal(el) {
    if (!settings.dragEnabled) return; 

    let modal = document.getElementById('rb-adjust-modal');
    if(!modal){
        modal = document.createElement('div');
        modal.id = 'rb-adjust-modal';
        document.getElementById('rb-root').appendChild(modal);
    }

    let targetObj = null;
    let isStick = false;
    let isCombo = false;
    let id = el.dataset.id;

    if (id) {
        if (!settings.layout[id]) settings.layout[id] = { x: 50, y: 50, size: 66, opacity: 0.6 };
        targetObj = settings.layout[id];
        if (id.includes('_stick')) isStick = true;
    } else if (el.dataset.comboId) {
        targetObj = settings.combos.find(c => c.id === el.dataset.comboId);
        isCombo = true;
    }

    if (!targetObj) return;

    const currentName = isCombo ? targetObj.name : (settings.names[id] || (BUTTONS[id] ? BUTTONS[id].name : ''));
    const currentIcon = id && settings.icons ? (settings.icons[id] || '') : '';
    const currentSize = targetObj.size || 66;
    const currentOpacity = targetObj.opacity || 0.6;

    modal.innerHTML = `
        <h3>✏️ ${t('adjustTitle')}</h3>
        ${!isStick ? `
        <div class="rb-setting">
            <div class="rb-setting-title"><span>${t('adjustName')}</span></div>
            <input type="text" id="rb-adj-name" value="${escapeHTML(currentName)}">
        </div>` : ''}
        ${(!isStick && !isCombo) ? `
        <div class="rb-setting">
            <div class="rb-setting-title"><span>${t('adjustIcon')}</span></div>
            <input type="text" id="rb-adj-icon" placeholder="https://... 或 Base64" value="${escapeHTML(currentIcon)}">
        </div>` : ''}
        <div class="rb-setting">
            <div class="rb-setting-title">
                <span>${t('adjustSize')}</span>
                <span id="rb-adj-size-val">${currentSize}px</span>
            </div>
            <input type="range" id="rb-adj-size" min="30" max="220" step="1" value="${currentSize}">
        </div>
        <div class="rb-setting">
            <div class="rb-setting-title">
                <span>${t('adjustOpacity')}</span>
                <span id="rb-adj-opac-val">${Math.round(currentOpacity * 100)}%</span>
            </div>
            <input type="range" id="rb-adj-opac" min="0.10" max="1" step="0.01" value="${currentOpacity}">
        </div>
        <button class="rb-ui-button" id="rb-adj-save" style="width:100%;margin-top:15px;background:rgba(0,180,80,.6);">${t('adjustConfirm')}</button>
    `;

    modal.classList.add('open');

    const sizeInput = document.getElementById('rb-adj-size');
    const opacInput = document.getElementById('rb-adj-opac');
    const nameInput = document.getElementById('rb-adj-name');
    const iconInput = document.getElementById('rb-adj-icon');

    sizeInput.addEventListener('input', () => {
        const val = sizeInput.value;
        document.getElementById('rb-adj-size-val').textContent = `${val}px`;
        targetObj.size = Number(val);
        el.style.width = `${val}px`;
        el.style.height = `${val}px`;
    });

    opacInput.addEventListener('input', () => {
        const val = opacInput.value;
        document.getElementById('rb-adj-opac-val').textContent = `${Math.round(val * 100)}%`;
        targetObj.opacity = Number(val);
        el.style.opacity = val;
    });

    if (nameInput) {
        nameInput.addEventListener('input', () => {
            const val = nameInput.value;
            if (isCombo) {
                targetObj.name = val;
                const label = el.querySelector('.rb-label');
                if (label) label.textContent = val;
            } else if (id) {
                settings.names[id] = val;
                updateButtonLabel(id);
            }
        });
    }

    if (iconInput && id) {
        iconInput.addEventListener('input', () => {
            if(!settings.icons) settings.icons = {};
            settings.icons[id] = iconInput.value.trim();
            updateButtonLabel(id);
        });
    }

    document.getElementById('rb-adj-save').addEventListener('click', () => {
        saveSettings();
        modal.classList.remove('open');
    });
}

function bindButton(el, index){
    let pressed = false;
    let longPressTimer = null;

    function handleDown(e) {
        if (settings.dragEnabled) {
            longPressTimer = setTimeout(() => {
                triggerHaptic();
                openAdjustModal(el);
            }, 600);
            startDrag(el, e); 
            return; 
        }

        if (e.cancelable) e.preventDefault(); 
        e.stopPropagation();
        if (pressed) return;
        pressed = true;
        el.classList.add('rb-pressed');
        press(index);
    }

    function handleUp(e) {
        if (longPressTimer) clearTimeout(longPressTimer);
        if(state.dragging && state.dragTarget === el){ endDrag(e); return; }
        if(!pressed) return;
        pressed = false;
        if (e.cancelable) e.preventDefault();
        e.stopPropagation();
        release(index);
        el.classList.remove('rb-pressed');
    }

    el.addEventListener('touchstart', handleDown, { passive: false });
    el.addEventListener('touchend', handleUp, { passive: false });
    el.addEventListener('touchcancel', handleUp, { passive: false });

    el.addEventListener('pointerdown', e => { if (e.pointerType === 'mouse') handleDown(e); }, { passive: false });
    el.addEventListener('pointerup', e => { if (e.pointerType === 'mouse') handleUp(e); }, { passive: false });
}

function triggerHaptic(){
    if (navigator.vibrate) navigator.vibrate(40);
}

function createStickHUD(id){
    const el = document.createElement('div');
    el.id = `rb-${id}-stick`;
    el.className = 'rb-stick-base';
    el.dataset.id = `${id}_stick`;

    const miniBadge = document.createElement('div');
    miniBadge.className = 'rb-mini-label';
    miniBadge.textContent = id.toUpperCase();
    el.appendChild(miniBadge);

    const knob = document.createElement('div');
    knob.className = 'rb-knob';
    el.appendChild(knob);

    applyLayout(el, `${id}_stick`);
    return el;
}

function bindStick(stick, type){
    const isLS = type === 'ls';
    let longPressTimer = null;

    function handleStart(clientX, clientY, identifier) {
        if (settings.dragEnabled) {
            longPressTimer = setTimeout(() => {
                triggerHaptic();
                openAdjustModal(stick);
            }, 600);
        }

        if(isLS) state.lsTouchId = identifier;
        else state.rsTouchId = identifier;
        updateStickValue(stick, type, clientX, clientY);
    }

    function handleMove(clientX, clientY, identifier) {
        if (longPressTimer) clearTimeout(longPressTimer);
        const activeId = isLS ? state.lsTouchId : state.rsTouchId;
        if(activeId !== identifier) return;
        updateStickValue(stick, type, clientX, clientY);
    }

    function handleEnd(identifier) {
        if (longPressTimer) clearTimeout(longPressTimer);
        const activeId = isLS ? state.lsTouchId : state.rsTouchId;
        if(activeId !== identifier) return;
        if(isLS){ state.lsTouchId = null; state.leftX = 0; state.leftY = 0; } 
        else { state.rsTouchId = null; state.rightX = 0; state.rightY = 0; }
        const knob = stick.querySelector('.rb-knob');
        if(knob) knob.style.transform = 'translate(0,0)';
        updateGamepad();
    }

    stick.addEventListener('touchstart', e => {
        if(canDrag()){ startDrag(stick, e); return; }
        e.preventDefault(); e.stopPropagation();
        const touch = e.changedTouches[0];
        handleStart(touch.clientX, touch.clientY, touch.identifier);
    }, { passive: false });

    document.addEventListener('touchmove', e => {
        if(state.dragging) return;
        const activeId = isLS ? state.lsTouchId : state.rsTouchId;
        if(activeId === null) return;
        for(let i=0; i<e.changedTouches.length; i++){
            if(e.changedTouches[i].identifier === activeId){
                e.preventDefault();
                handleMove(e.changedTouches[i].clientX, e.changedTouches[i].clientY, activeId);
                break;
            }
        }
    }, { passive: false });

    document.addEventListener('touchend', e => {
        const activeId = isLS ? state.lsTouchId : state.rsTouchId;
        if(activeId === null) return;
        for(let i=0; i<e.changedTouches.length; i++){
            if(e.changedTouches[i].identifier === activeId){
                handleEnd(activeId);
                break;
            }
        }
    }, { passive: false });

    stick.addEventListener('mousedown', e => {
        if(canDrag()){ startDrag(stick, e); return; }
        e.preventDefault();
        handleStart(e.clientX, e.clientY, 'mouse');
        const onMouseMove = me => handleMove(me.clientX, me.clientY, 'mouse');
        const onMouseUp = () => { handleEnd('mouse'); document.removeEventListener('mousemove', onMouseMove); document.removeEventListener('mouseup', onMouseUp); };
        document.addEventListener('mousemove', onMouseMove);
        document.addEventListener('mouseup', onMouseUp);
    });
}

function updateStickValue(stick, type, px, py){
    const rect = stick.getBoundingClientRect();
    const cx = rect.left + rect.width / 2;
    const cy = rect.top + rect.height / 2;
    let x = (px - cx) / (rect.width / 2);
    let y = (py - cy) / (rect.height / 2);
    const distance = Math.sqrt(x*x + y*y);

    if(distance > 1){ x /= distance; y /= distance; }
    const dz = CFG.DEADZONE;
    if(Math.abs(x) < dz) x = 0; else x = Math.sign(x) * (Math.abs(x) - dz) / (1 - dz);
    if(Math.abs(y) < dz) y = 0; else y = Math.sign(y) * (Math.abs(y) - dz) / (1 - dz);

    if(type === 'ls'){ state.leftX = Math.max(-1, Math.min(1, x)); state.leftY = Math.max(-1, Math.min(1, y)); }
    else { state.rightX = Math.max(-1, Math.min(1, x)); state.rightY = Math.max(-1, Math.min(1, y)); }

    const knob = stick.querySelector('.rb-knob');
    if(knob) knob.style.transform = `translate(${x * (rect.width * 0.3)}px, ${y * (rect.height * 0.3)}px)`;
    updateGamepad();
}

function bindTouchpad(tp){
    let startX = 0, startY = 0;
    const maxRadius = 55;

    tp.addEventListener('pointerdown', e => {
        if(canDrag() || state.panel) return;
        e.preventDefault();
        state.rsTouchPointer = e.pointerId;
        startX = e.clientX; startY = e.clientY;
        try{ tp.setPointerCapture(e.pointerId); } catch(_){}
    }, { passive:false });

    tp.addEventListener('pointermove', e => {
        if(state.rsTouchPointer !== e.pointerId) return;
        e.preventDefault();
        let dx = e.clientX - startX; let dy = e.clientY - startY;
        let x = dx / maxRadius; let y = dy / maxRadius;
        const len = Math.sqrt(x*x + y*y);
        if(len > 1){ x /= len; y /= len; }
        state.rightX = Math.max(-1, Math.min(1, x)); state.rightY = Math.max(-1, Math.min(1, y));
        updateGamepad();
    }, { passive:false });

    function stopTouchpad(e){
        if(state.rsTouchPointer !== e.pointerId) return;
        state.rsTouchPointer = null; state.rightX = 0; state.rightY = 0; updateGamepad();
    }
    tp.addEventListener('pointerup', stopTouchpad, { passive:false });
    tp.addEventListener('pointercancel', stopTouchpad, { passive:false });
}

function setRSMode(mode){
    settings.rsMode = mode;
    const rsStick = document.getElementById('rb-rs-stick');
    const tp = document.getElementById('rb-touchpad');
    const label = document.getElementById('rb-rsmode-value');

    if(mode === 'touchpad'){
        if(rsStick) rsStick.style.display = 'none';
        if(tp) tp.classList.add('active');
        if(label) label.textContent = t('rsModeTouchpad');
    } else {
        if(rsStick) rsStick.style.display = 'block';
        if(tp) tp.classList.remove('active');
        if(label) label.textContent = t('rsModeStick');
    }
    saveSettings();
}

function bindCombo(el, combo){
    let active = false;
    let longPressTimer = null;

    function startCombo(e) {
        if (settings.dragEnabled) {
            longPressTimer = setTimeout(() => {
                triggerHaptic();
                openAdjustModal(el);
            }, 600);
            startDrag(el, e); 
            return; 
        }

        if (e.cancelable) e.preventDefault(); 
        e.stopPropagation();
        if (active) return;
        active = true;
        comboStart(combo);
    }

    function stopCombo(e) {
        if (longPressTimer) clearTimeout(longPressTimer);
        if(state.dragging && state.dragTarget === el){ endDrag(e); return; }
        if(!active) return;
        active = false;
        if (e.cancelable) e.preventDefault();
        e.stopPropagation();
        comboStop(combo);
    }

    el.addEventListener('touchstart', startCombo, { passive: false });
    el.addEventListener('touchend', stopCombo, { passive: false });
    el.addEventListener('touchcancel', stopCombo, { passive: false });

    el.addEventListener('pointerdown', e => { if (e.pointerType === 'mouse') startCombo(e); }, { passive: false });
    el.addEventListener('pointerup', e => { if (e.pointerType === 'mouse') stopCombo(e); }, { passive: false });
}

function bindCamera(camera){
    camera.addEventListener('pointerdown', e => {
        if(canDrag() || state.panel || state.inputMode || settings.rsMode === 'touchpad') return;
        state.cameraPointer = e.pointerId;
        state.cameraLastX = e.clientX; state.cameraLastY = e.clientY;
        try{ camera.setPointerCapture(e.pointerId); } catch(_){}
    }, { passive:false });

    camera.addEventListener('pointermove', e => {
        if(canDrag() || state.panel || state.inputMode || settings.rsMode === 'touchpad') return;
        if(state.cameraPointer !== e.pointerId) return;
        e.preventDefault();
        const dx = e.clientX - state.cameraLastX;
        const dy = e.clientY - state.cameraLastY;
        state.cameraLastX = e.clientX; state.cameraLastY = e.clientY;
        state.cameraX = Math.max(-1, Math.min(1, dx * settings.cameraX * settings.cameraBoost));
        state.cameraY = Math.max(-1, Math.min(1, dy * settings.cameraY * settings.cameraBoost));
        updateGamepad();
    }, { passive:false });

    function stopCamera(e){
        if(state.cameraPointer !== e.pointerId) return;
        state.cameraPointer = null; state.cameraLastX = null; state.cameraLastY = null;
        state.cameraX = 0; state.cameraY = 0; updateGamepad();
    }
    camera.addEventListener('pointerup', stopCamera, { passive:false });
    camera.addEventListener('pointercancel', stopCamera, { passive:false });
}

