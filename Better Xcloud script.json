let settings = {
    lang: (navigator.language || '').toLowerCase().startsWith('zh') ? 'zh' : 'en',
    layout: JSON.parse(JSON.stringify(DEFAULT_LAYOUT)),
    names: {},
    icons: {},
    combos: JSON.parse(JSON.stringify(DEFAULT_COMBOS)),
    cameraX: CFG.DEFAULT_CAMERA_X,
    cameraY: CFG.DEFAULT_CAMERA_Y,
    cameraBoost: CFG.DEFAULT_CAMERA_BOOST,
    dragEnabled: false,
    rsMode: 'stick'
};

let gameProfiles = {};

function t(key, ...args){
    const langDict = I18N[settings.lang] || I18N.en;
    const val = langDict[key] || I18N.en[key] || key;
    return typeof val === 'function' ? val(...args) : val;
}

function loadSettings(){
    try{
        const raw = localStorage.getItem(CFG.STORAGE);
        if(raw){
            const data = JSON.parse(raw);
            if(data.lang && (data.lang === 'zh' || data.lang === 'en')) settings.lang = data.lang;
            if(data.layout){
                Object.keys(DEFAULT_LAYOUT).forEach(id => {
                    if(data.layout[id]) settings.layout[id] = { ...settings.layout[id], ...data.layout[id] };
                });
            }
            if(data.names) settings.names = { ...data.names };
            if(data.icons) settings.icons = { ...data.icons };
            if(Array.isArray(data.combos)) settings.combos = data.combos;
            if(typeof data.cameraX === 'number') settings.cameraX = data.cameraX;
            if(typeof data.cameraY === 'number') settings.cameraY = data.cameraY;
            if(typeof data.cameraBoost === 'number') settings.cameraBoost = data.cameraBoost;
            if(data.rsMode) settings.rsMode = data.rsMode;
        }
    } catch(e){ console.warn('[Universal HUD] Load failed', e); }
}

function saveSettings(){
    try{ localStorage.setItem(CFG.STORAGE, JSON.stringify(settings)); } catch(e){}
}

function loadGameProfiles(){
    try{
        const raw = localStorage.getItem(CFG.GAME_PROFILES);
        if(raw) gameProfiles = JSON.parse(raw);
    } catch(e){ gameProfiles = {}; }
}

function saveGameProfiles(){
    try{ localStorage.setItem(CFG.GAME_PROFILES, JSON.stringify(gameProfiles)); } catch(e){}
}

function createProfileSnapshot(){
    return {
        lang: settings.lang,
        layout: JSON.parse(JSON.stringify(settings.layout)),
        names: JSON.parse(JSON.stringify(settings.names)),
        icons: JSON.parse(JSON.stringify(settings.icons)),
        combos: JSON.parse(JSON.stringify(settings.combos)),
        cameraX: settings.cameraX,
        cameraY: settings.cameraY,
        cameraBoost: settings.cameraBoost,
        rsMode: settings.rsMode
    };
}

function applyProfile(profile){
    if(!profile) return;
    if(profile.lang && (profile.lang === 'zh' || profile.lang === 'en')) settings.lang = profile.lang;
    if(profile.layout){
        Object.keys(DEFAULT_LAYOUT).forEach(id => {
            if(profile.layout[id]) settings.layout[id] = { ...settings.layout[id], ...profile.layout[id] };
        });
    }
    if(profile.names) settings.names = { ...profile.names };
    if(profile.icons) settings.icons = { ...profile.icons };
    if(Array.isArray(profile.combos)) settings.combos = JSON.parse(JSON.stringify(profile.combos));
    if(typeof profile.cameraX === 'number') settings.cameraX = profile.cameraX;
    if(typeof profile.cameraY === 'number') settings.cameraY = profile.cameraY;
    if(typeof profile.cameraBoost === 'number') settings.cameraBoost = profile.cameraBoost;
    if(profile.rsMode) settings.rsMode = profile.rsMode;
    saveSettings();
}

function refreshHUD(){
    Object.keys(BUTTONS).forEach(id => {
        if(BUTTONS[id].type) return;
        const el = document.getElementById(`rb-${id}`);
        if(!el) return;
        applyLayout(el, id);
        updateButtonLabel(id);
    });

    const lsStick = document.getElementById('rb-ls-stick');
    if(lsStick) applyLayout(lsStick, 'ls_stick');

    const rsStick = document.getElementById('rb-rs-stick');
    if(rsStick) applyLayout(rsStick, 'rs_stick');

    setRSMode(settings.rsMode || 'stick');

    document.querySelectorAll('.rb-combo').forEach(el => {
        const combo = settings.combos.find(c => c.id === el.dataset.comboId);
        if(combo){
            el.style.left = `${combo.x}%`;
            el.style.top = `${combo.y}%`;
            el.style.width = `${combo.size}px`;
            el.style.height = `${combo.size}px`;
            el.style.opacity = combo.opacity;
            const label = el.querySelector('.rb-label');
            if(label) label.textContent = combo.name;
        }
    });
}

loadSettings();
loadGameProfiles();

let originalGetGamepads = null;
let virtualGamepad = null;
const buttonPressTimes = new Array(16).fill(0);

function makeButton(value){ return { pressed: !!value, touched: !!value, value: value ? 1 : 0 }; }

function buildGamepad(){
    return {
        id: 'Xbox 360 Controller - Universal Touch HUD',
        index: 0, connected: true, timestamp: performance.now(), mapping: 'standard',
        axes: [...state.axes], buttons: state.buttons.map(makeButton),
        vibrationActuator: null, hapticActuators: []
    };
}

function updateGamepad(){
    let finalLX = state.leftX + state.comboLeftX;
    let finalLY = state.leftY + state.comboLeftY;
    let finalRX = state.rightX + state.comboRightX;
    let finalRY = state.rightY + state.comboRightY;

    state.axes[0] = Math.max(-1, Math.min(1, finalLX));
    state.axes[1] = Math.max(-1, Math.min(1, finalLY));

    if(settings.rsMode === 'touchpad' || finalRX !== 0 || finalRY !== 0){
        state.axes[2] = Math.max(-1, Math.min(1, finalRX));
        state.axes[3] = Math.max(-1, Math.min(1, finalRY));
    } else {
        state.axes[2] = state.cameraX;
        state.axes[3] = state.cameraY;
    }
    virtualGamepad = buildGamepad();
}

function installGamepadHook(){
    if(!navigator.getGamepads) return;
    try{
        originalGetGamepads = navigator.getGamepads.bind(navigator);
        navigator.getGamepads = function(){
            const real = originalGetGamepads();
            if(!virtualGamepad) updateGamepad();
            const result = Array.from(real || []);
            result[0] = virtualGamepad;
            return result;
        };
    } catch(e){ console.warn('[Universal HUD] Gamepad hook failed', e); }
}

installGamepadHook();

function press(index){ buttonPressTimes[index] = performance.now(); state.buttons[index] = true; updateGamepad(); }
function release(index){
    const holdTime = performance.now() - buttonPressTimes[index];
    if (holdTime < 80) setTimeout(() => { state.buttons[index] = false; updateGamepad(); }, 80 - holdTime);
    else { state.buttons[index] = false; updateGamepad(); }
}

function applyKeyAction(key, mode = 'press'){
    const def = BUTTONS[key];
    if(!def) return;
    const factor = mode === 'press' ? 1 : -1;
    if(def.type === 'stick'){
        if(def.stick === 'ls'){
            if(def.axis === 'X') state.comboLeftX += def.val * factor;
            if(def.axis === 'Y') state.comboLeftY += def.val * factor;
        } else if(def.stick === 'rs'){
            if(def.axis === 'X') state.comboRightX += def.val * factor;
            if(def.axis === 'Y') state.comboRightY += def.val * factor;
        }
    } else {
        if(mode === 'press') press(def.index);
        else release(def.index);
    }
}

function comboStart(combo){
    for(const key of combo.keys) applyKeyAction(key, 'press');
    updateGamepad();
    const el = document.querySelector(`[data-combo-id="${combo.id}"]`);
    if(el) el.classList.add('rb-pressed');
}

function comboStop(combo){
    for(const key of combo.keys) applyKeyAction(key, 'release');
    updateGamepad();
    const el = document.querySelector(`[data-combo-id="${combo.id}"]`);
    if(el) el.classList.remove('rb-pressed');
}

