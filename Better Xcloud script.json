                <span id="rb-camx-value">${settings.cameraX.toFixed(3)}</span>
            </div>
            <input id="rb-camx" type="range" min="0.01" max="0.30" step="0.005" value="${settings.cameraX}">
        </div>

        <div class="rb-setting">
            <div class="rb-setting-title">
                <span>${t('camY')}</span>
                <span id="rb-camy-value">${settings.cameraY.toFixed(3)}</span>
            </div>
            <input id="rb-camy" type="range" min="0.01" max="0.30" step="0.005" value="${settings.cameraY}">
        </div>

        <div class="rb-setting">
            <div class="rb-setting-title">
                <span>${t('camBoost')}</span>
                <span id="rb-boost-value">${settings.cameraBoost.toFixed(1)}</span>
            </div>
            <input id="rb-boost" type="range" min="0.5" max="5" step="0.1" value="${settings.cameraBoost}">
        </div>

        <div class="rb-section">
            <b>${t('comboSection')}</b>
            <div id="rb-combos"></div>
            <button class="rb-ui-button" id="rb-add-combo" style="width:100%;margin-top:10px">${t('comboAddBtn')}</button>
        </div>

        <div class="rb-actions">
            <button class="rb-ui-button" id="rb-reset">${t('resetBtn')}</button>
            <button class="rb-ui-button" id="rb-save">${t('saveBtn')}</button>
            <button class="rb-ui-button" id="rb-close" style="grid-column:1/3">${t('closeBtn')}</button>
        </div>
    `;

    buildComboSettings();
    buildProfileList();
    bindPanelEvents();
}

function createPanel(){
    const panel = document.createElement('div');
    panel.id = 'rb-panel';
    document.getElementById('rb-root').appendChild(panel);
    renderPanelContent();
}

function comboOptions(selected){
    let html = '';
    Object.keys(BUTTONS).forEach(key => {
        const checked = selected.includes(key);
        html += `<option value="${key}" ${checked ? 'selected' : ''}>${BUTTONS[key].name}</option>`;
    });
    return html;
}

function buildComboSettings(){
    const container = document.getElementById('rb-combos');
    if(!container) return;
    container.innerHTML = '';

    settings.combos.forEach(combo => {
        const item = document.createElement('div');
        item.className = 'rb-combo-item';

        item.innerHTML = `
            <div class="rb-control-title">${t('comboTitle')}</div>
            <div class="rb-setting">
                <div class="rb-setting-title"><span>${t('adjustName')}</span></div>
                <input type="text" data-combo-name value="${escapeHTML(combo.name)}">
            </div>
            <div class="rb-setting">
                <div class="rb-setting-title"><span>${t('comboSection')}</span><span>${t('comboMultiSelect')}</span></div>
                <select multiple data-combo-keys size="8">${comboOptions(combo.keys)}</select>
            </div>
            <button class="rb-combo-delete" data-combo-delete>${t('comboDeleteBtn')}</button>
        `;

        container.appendChild(item);

        const name = item.querySelector('[data-combo-name]');
        name.addEventListener('input', () => {
            combo.name = name.value;
            const el = document.querySelector(`[data-combo-id="${combo.id}"]`);
            if(el){ const label = el.querySelector('.rb-label'); if(label) label.textContent = combo.name; }
            saveSettings();
        });

        const keys = item.querySelector('[data-combo-keys]');
        keys.addEventListener('change', () => {
            combo.keys = Array.from(keys.selectedOptions).map(option => option.value);
            saveSettings();
        });

        item.querySelector('[data-combo-delete]').addEventListener('click', () => {
            settings.combos = settings.combos.filter(c => c.id !== combo.id);
            const el = document.querySelector(`[data-combo-id="${combo.id}"]`);
            if(el) el.remove();
            buildComboSettings();
            saveSettings();
        });
    });
}

function escapeHTML(value){
    return String(value || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
}

function addCombo(){
    const id = 'combo_' + Date.now();
    const combo = { id: id, name: t('newComboDefaultName'), keys: [], x: 50, y: 70, size: 62, opacity: .60 };
    settings.combos.push(combo);

    const root = document.getElementById('rb-root');
    const el = createCombo(combo);
    root.appendChild(el);

    bindCombo(el, combo);
    buildComboSettings();
    saveSettings();
}

function buildProfileList(){
    const box = document.getElementById('rb-profile-list');
    if(!box) return;
    box.innerHTML = '';
    const names = Object.keys(gameProfiles);
    if(names.length === 0){
        box.innerHTML = `<div style="opacity:.55;text-align:center;padding:8px;font-size:12px;">${t('profileNoList')}</div>`;
        return;
    }

    names.forEach(gameName => {
        const item = document.createElement('div');
        item.className = 'rb-profile-item';

        const name = document.createElement('div');
        name.className = 'rb-profile-name';
        name.textContent = gameName;

        const load = document.createElement('button');
        load.className = 'rb-profile-load';
        load.textContent = t('profileLoad');
        load.addEventListener('click', () => {
            document.getElementById('rb-game-profile').value = gameName;
            loadGameProfile(gameName);
        });

        const del = document.createElement('button');
        del.className = 'rb-profile-delete';
        del.textContent = t('profileDelete');
        del.addEventListener('click', () => {
            if(!confirm(t('profileConfirmDelete', gameName))) return;
            delete gameProfiles[gameName];
            saveGameProfiles();
            buildProfileList();
        });

        item.appendChild(name); item.appendChild(load); item.appendChild(del);
        box.appendChild(item);
    });
}

function saveGameProfile(){
    const input = document.getElementById('rb-game-profile');
    if(!input) return;
    const gameName = input.value.trim();
    if(!gameName){ alert(t('profileSaveAlert')); input.focus(); return; }
    gameProfiles[gameName] = createProfileSnapshot();
    saveGameProfiles(); saveSettings(); buildProfileList();
    const status = document.getElementById('rb-profile-status');
    if(status) status.textContent = t('profileSavedStatus', gameName);
}

function loadGameProfile(gameName){
    gameName = String(gameName || '').trim();
    if(!gameName){ alert(t('profileSaveAlert')); return; }
    const profile = gameProfiles[gameName];
    if(!profile){ alert(t('profileNotFound', gameName)); return; }

    applyProfile(profile);

    document.querySelectorAll('.rb-combo').forEach(el => el.remove());
    settings.combos.forEach(combo => {
        const root = document.getElementById('rb-root');
        const el = createCombo(combo);
        root.appendChild(el);
        bindCombo(el, combo);
    });

    refreshHUD();
    renderPanelContent();

    const status = document.getElementById('rb-profile-status');
    if(status) status.textContent = t('profileLoadedStatus', gameName);
}

function exportShareCode(){
    try {
        const snapshot = createProfileSnapshot();
        const code = 'HUD1:' + btoa(encodeURIComponent(JSON.stringify(snapshot)));
        const area = document.getElementById('rb-share-code');
        if(area) area.value = code;

        navigator.clipboard.writeText(code).then(() => {
            const status = document.getElementById('rb-share-status');
            if(status) status.textContent = t('shareExportSuccessClipboard');
        }).catch(() => {
            const status = document.getElementById('rb-share-status');
            if(status) status.textContent = t('shareExportSuccessManual');
        });
    } catch(e) { alert('Export Failed'); }
}

function importShareCode(){
    const area = document.getElementById('rb-share-code');
    if(!area) return;
    let raw = area.value.trim();
    if(!raw){ alert(t('sharePasteAlert')); return; }

    try {
        if(raw.startsWith('HUD1:')){ raw = raw.replace('HUD1:', ''); }
        const profile = JSON.parse(decodeURIComponent(atob(raw)));
        if(!profile.layout){ throw new Error('Invalid Format'); }

        applyProfile(profile);

        document.querySelectorAll('.rb-combo').forEach(el => el.remove());
        settings.combos.forEach(combo => {
            const root = document.getElementById('rb-root');
            const el = createCombo(combo);
            root.appendChild(el);
            bindCombo(el, combo);
        });

        refreshHUD(); renderPanelContent();
        alert(t('shareImportSuccess'));
    } catch(e) { alert(t('shareImportFail')); }
}

function updateDragUI(){
    const editBtn = document.getElementById('rb-edit-toggle');
    if(editBtn) {
        if(settings.dragEnabled) editBtn.classList.add('active');
        else editBtn.classList.remove('active');
    }
}

function bindPanelEvents(){
    const langSelect = document.getElementById('rb-lang-select');
    if(langSelect){
        langSelect.addEventListener('change', e => {
            settings.lang = e.target.value;
            saveSettings(); renderPanelContent();
        });
    }

    document.getElementById('rb-export-code').addEventListener('click', exportShareCode);
    document.getElementById('rb-import-code').addEventListener('click', importShareCode);

    document.getElementById('rb-toggle-rsmode').addEventListener('click', () => {
        setRSMode(settings.rsMode === 'touchpad' ? 'stick' : 'touchpad');
    });

    document.getElementById('rb-camx').addEventListener('input', e => {
        settings.cameraX = Number(e.target.value);
        document.getElementById('rb-camx-value').textContent = settings.cameraX.toFixed(3);
        saveSettings();
    });

    document.getElementById('rb-camy').addEventListener('input', e => {
        settings.cameraY = Number(e.target.value);
        document.getElementById('rb-camy-value').textContent = settings.cameraY.toFixed(3);
        saveSettings();
    });

    document.getElementById('rb-boost').addEventListener('input', e => {
        settings.cameraBoost = Number(e.target.value);
        document.getElementById('rb-boost-value').textContent = settings.cameraBoost.toFixed(1);
        saveSettings();
    });

    document.getElementById('rb-add-combo').addEventListener('click', addCombo);
    document.getElementById('rb-profile-save').addEventListener('click', saveGameProfile);
    document.getElementById('rb-profile-load').addEventListener('click', () => {
        const input = document.getElementById('rb-game-profile');
        if(input) loadGameProfile(input.value);
    });

    document.getElementById('rb-panel-close-fixed').addEventListener('click', closePanel);
    document.getElementById('rb-close').addEventListener('click', closePanel);
    document.getElementById('rb-save').addEventListener('click', () => saveSettings());

    document.getElementById('rb-reset').addEventListener('click', () => {
        if(!confirm(t('resetConfirm'))) return;
        settings.layout = JSON.parse(JSON.stringify(DEFAULT_LAYOUT));
        refreshHUD();
        saveSettings();
    });

    updateDragUI();
}

function openPanel(){ state.panel = true; document.getElementById('rb-panel').classList.add('open'); }
function closePanel(){ state.panel = false; document.getElementById('rb-panel').classList.remove('open'); }

function build(){
    if(document.getElementById('rb-root')) return;

    const root = document.createElement('div');
    root.id = 'rb-root';

    const camera = document.createElement('div');
    camera.id = 'rb-camera';
    root.appendChild(camera);

    const tp = document.createElement('div');
    tp.id = 'rb-touchpad';
    root.appendChild(tp);

    const lsStick = createStickHUD('ls'); root.appendChild(lsStick);
    const rsStick = createStickHUD('rs'); root.appendChild(rsStick);

    Object.keys(BUTTONS).forEach(id => {
        if(BUTTONS[id].type) return;
        const el = createButton(id);
        root.appendChild(el);
    });

    settings.combos.forEach(combo => {
        const el = createCombo(combo);
        root.appendChild(el);
    });

    const open = document.createElement('button');
    open.id = 'rb-open'; open.textContent = '⚙'; open.type = 'button';
    root.appendChild(open);

    const editToggle = document.createElement('button');
    editToggle.id = 'rb-edit-toggle'; editToggle.textContent = '✏️'; editToggle.type = 'button';
    root.appendChild(editToggle);

    const inputToggle = document.createElement('button');
    inputToggle.id = 'rb-input-toggle'; inputToggle.textContent = '⌨️'; inputToggle.type = 'button';
    root.appendChild(inputToggle);

    document.body.appendChild(root);

    createPanel();
    bindCamera(camera);
    bindStick(lsStick, 'ls');
    bindStick(rsStick, 'rs');
    bindTouchpad(tp);

    Object.keys(BUTTONS).forEach(id => {
        if(BUTTONS[id].type) return;
        const el = document.getElementById(`rb-${id}`);
        if(el) bindButton(el, BUTTONS[id].index);
    });

    settings.combos.forEach(combo => {
        const el = document.querySelector(`[data-combo-id="${combo.id}"]`);
        if(el) bindCombo(el, combo);
    });

    /* 点击 ⚙ 逻辑：1次点击开/关设置，2次点击同时出现/隐藏 ✏️ 和 ⌨️ 图标 */
    let openClickCount = 0;
    let openClickTimer = null;

    open.addEventListener('click', e => {
        e.preventDefault(); e.stopPropagation();
        openClickCount++;
        clearTimeout(openClickTimer);

        openClickTimer = setTimeout(() => { 
            if (openClickCount === 2) {
                editToggle.classList.toggle('visible');
                inputToggle.classList.toggle('visible');
            } else if (openClickCount === 1) {
                if(state.panel) closePanel(); else openPanel();
            }
            openClickCount = 0; 
        }, 250);
    });

    editToggle.addEventListener('click', e => {
        e.preventDefault(); e.stopPropagation();
        settings.dragEnabled = !settings.dragEnabled;
        updateDragUI();
    });

    inputToggle.addEventListener('click', e => {
        e.preventDefault(); e.stopPropagation();
        state.inputMode = !state.inputMode;
        if(state.inputMode) {
            inputToggle.classList.add('active');
            root.classList.add('input-mode-active');
        } else {
            inputToggle.classList.remove('active');
            root.classList.remove('input-mode-active');
        }
    });

    document.addEventListener('touchmove', e => { if(state.dragging) moveDrag(e); }, { passive:false });
    document.addEventListener('touchend', e => { if(state.dragging) endDrag(e); }, { passive:false });
    document.addEventListener('touchcancel', e => { if(state.dragging) endDrag(e); }, { passive:false });

    document.addEventListener('pointermove', e => { if(state.dragging) moveDrag(e); }, { passive:false });
    document.addEventListener('pointerup', e => { if(state.dragging) endDrag(e); }, { passive:false });
    document.addEventListener('pointercancel', e => { if(state.dragging) endDrag(e); }, { passive:false });

    setRSMode(settings.rsMode || 'stick');
    updateDragUI();
    updateGamepad();
}

function waitBody(){
    if(document.body){ build(); return; }
    requestAnimationFrame(waitBody);
}
waitBody();

document.addEventListener('visibilitychange', () => {
    if(document.hidden){
        for(let i = 0; i < state.buttons.length; i++){ state.buttons[i] = false; }
        state.leftX = 0; state.leftY = 0; state.rightX = 0; state.rightY = 0;
        state.comboLeftX = 0; state.comboLeftY = 0; state.comboRightX = 0; state.comboRightY = 0;
        state.cameraX = 0; state.cameraY = 0;
        state.cameraPointer = null; state.lsTouchId = null; state.rsTouchId = null; state.rsTouchPointer = null;
        for(const combo of settings.combos){ comboStop(combo); }
        updateGamepad();
    }
});

})();